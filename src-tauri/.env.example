# =============================================================================
# 环境变量示例(桌面客户端)——复制为 .env 后按需修改:
#   cd src-tauri && cp .env.example .env
#
# 加载顺序(后加载的不会覆盖已存在的环境变量,dotenvy 行为):
#   1. EPUB_ENV_FILE 显式指定的路径(任意位置)
#   2. exe 同目录的 .env(打包版双击启动)
#   3. 工作目录的 .env(tauri dev / cargo run,即 src-tauri/)
#   4. AppData/com.ryu2u.epublibrary/.env
# =============================================================================

# ---- 数据目录(默认落 AppData,想与旧 Web 版共用数据可指向仓库 data/)----
# EPUB_STORAGE_DIR=C:\project\epub_project\data\storage
# EPUB_DATABASE_URL=sqlite:C:\project\epub_project\data\library.db

# ---- 可选:腾讯云 COS(四个变量全填才会启用,资源走云端)----
# EPUB_COS_SECRET_ID=你的SecretId
# EPUB_COS_SECRET_KEY=你的SecretKey
# EPUB_COS_BUCKET=你的桶名-数字后缀
# EPUB_COS_REGION=ap-nanjing
# EPUB_COS_KEY_PREFIX=books/{book_id}/assets/{asset_id}
