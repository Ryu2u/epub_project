# =============================================================================
# 环境变量示例 —— 复制为 .env 后按需修改：  cp .env.example .env
# 后端在容器内运行时，以下变量会传给 epub-backend 容器。
# =============================================================================

# ---- 必填/常用（不填用默认值）----
# 后端监听端口（容器内部端口，对外由 nginx 转发；不建议改）
# EPUB_PORT=8002
# 后端绑定地址（容器内保留 0.0.0.0）
# EPUB_BIND=0.0.0.0
# 单文件上传上限（MB）
# EPUB_MAX_UPLOAD_MB=100
# 跨域白名单（JSON 数组）。容器内前后端同源走 nginx，通常留空即可
# EPUB_CORS_ORIGINS=["http://localhost:3000"]

# ---- 可选：腾讯云 COS（不配置则资源走本地存储）----
# 四个变量全填才会启用 COS。
# EPUB_COS_SECRET_ID=你的SecretId
# EPUB_COS_SECRET_KEY=你的SecretKey
# EPUB_COS_BUCKET=你的桶名-数字后缀
# EPUB_COS_REGION=ap-nanjing
# EPUB_COS_KEY_PREFIX=books/{book_id}/assets/{asset_id}

# ---- 数据目录 ----
# 容器内数据默认在 /data（SQLite library.db + storage/），
# 已由 docker-compose 通过 `./data:/data` 映射到宿主当前目录。想换位置改 compose 里的 volumes 即可。
